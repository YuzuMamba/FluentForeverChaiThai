{
  "name": "chai-thai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chai Thai — a Fluent Forever–inspired Thai learning app. Conversational Thai, spaced repetition, sentence building, and a full Thai script course.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:single": "vite build --config vite.config.artifact.ts",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run",
    "shots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.2.5",
    "@fontsource-variable/noto-sans-thai": "^5.2.5",
    "@fontsource/noto-sans-thai-looped": "^5.2.5",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.182.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}
